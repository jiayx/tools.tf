{
  "name": "tools.tf",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "lint": "oxlint . --deny-warnings --deny typescript/no-floating-promises",
    "lint:fix": "oxlint . --fix",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "for config in apps/*/tsconfig.json packages/*/tsconfig.json; do tsc --noEmit -p \"$config\"; done"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [],
  "author": "jiayx",
  "packageManager": "pnpm@12.3.4"
}
